# Copy to .env and fill in. Never commit .env.

# --- Required for the api service (profiles, settings sync, guest book) ---------------------------
# Long random strings, private. Generate with: openssl rand -hex 32
API_SECRET=
ADMIN_TOKEN=

# --- Cars --------------------------------------------------------------------------------------------
# Cars in the picker as CLASS:NUMBER (class as printed in the IMSA points PDF: GTP, LMP2, GTDPRO, GTD).
# Empty = the defaults in app/common.py (Pratt Miller Corvettes, the GTP Cadillacs, AO Racing).
CARS=
# Cars followed in live timing only (their own Race tab, no championship maths), CLASS:NUMBER.
RACE_CARS=

# --- Timing ------------------------------------------------------------------------------------------
# Minutes between checks for a new championship points PDF.
INTERVAL_MINUTES=30
# Analysis tab: minutes of race time between in-race predictions.
ANALYSIS_MINUTES=60
# Weather at the track and radar nowcast: seconds between refreshes (race weekends only).
WX_LIVE_SECONDS=300

# --- Your domain (passkeys only work on the domain they were made for) ------------------------------
# RP_ID=yellowcarpoints.win
# ORIGINS=https://yellowcarpoints.win,https://www.yellowcarpoints.win

# --- Optional: Cloudflare Turnstile spam check on the guest book -------------------------------------
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# --- Cloudflare tunnel: run cloudflared as this user so it can read ~/.cloudflared (defaults 1000) ----
# TUNNEL_UID=1000
# TUNNEL_GID=1000
