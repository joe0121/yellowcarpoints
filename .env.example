# Cars in the picker as CLASS:NUMBER (class as printed in the IMSA points PDF: GTP, LMP2, GTDPRO, GTD).
# Leave empty for the Corvettes: GTDPRO:4,GTDPRO:3,GTDPRO:74,GTD:13,GTD:36,GTD:81
CARS=
INTERVAL_MINUTES=30
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install token
TUNNEL_TOKEN=
# Uncomment once TUNNEL_TOKEN is set so a plain `docker compose up -d` also starts the tunnel
#COMPOSE_PROFILES=tunnel
# OpenWEC (api.openwec.com) key for lap/stint/pace endpoints
OPENWEC_API_KEY=
