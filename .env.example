# Class as it appears in the IMSA points PDF: GTP, LMP2, GTDPRO, GTD
CLASS=GTDPRO
# Car numbers to highlight, comma separated (first is yellow, second blue), e.g. 4,3
CARS=4
INTERVAL_MINUTES=30
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install token
TUNNEL_TOKEN=
# Uncomment once TUNNEL_TOKEN is set so a plain `docker compose up -d` also starts the tunnel
#COMPOSE_PROFILES=tunnel
