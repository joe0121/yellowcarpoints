{
	# Request/byte counters for the status page (served on :8089 only).
	metrics
	servers :80 {
		name public
	}
	servers :8089 {
		name status
	}
}

# Public site (the Cloudflare tunnel points here).
:80 {
	root * /srv
	encode gzip
	# Always revalidate so visitors get a new page/data as soon as it's deployed.
	header Cache-Control "no-cache"
	header -Server
	# Anonymous profiles and the guest book. Admin routes are never served publicly, and any
	# X-Admin header a visitor sends is stripped before it reaches the API.
	handle /api/admin/* {
		respond 404
	}
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy api:8000 {
			header_up -X-Admin
		}
	}
	handle {
		file_server
	}
}

# Local-only status page: published on 127.0.0.1:8089 and never routed through the tunnel.
:8089 {
	header Cache-Control "no-cache"
	handle /metrics {
		metrics
	}
	# Guest book moderation from the status page: this local server adds the admin token.
	handle /api/admin/* {
		reverse_proxy api:8000 {
			header_up X-Admin {$ADMIN_TOKEN}
		}
	}
	handle /tunnel-metrics {
		rewrite * /metrics
		reverse_proxy cloudflared:2000
	}
	handle {
		root * /srv-status
		file_server
	}
}
